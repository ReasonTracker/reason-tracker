{
  "name": "reason-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "developer:setup-machine": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-machine.ps1",
    "typecheck": "vp run -r typecheck",
    "maintain:markdown": "vp exec node ./scripts/maintain-markdown.mjs --write-report",
    "architecture:map": "vp exec node ./scripts/generate-architecture-map.mjs",
    "architecture:check": "vp exec node ./scripts/generate-architecture-map.mjs --check",
    "website:dev": "vp run -F @reasontracker/website dev",
    "website:build": "vp run -F @reasontracker/website build",
    "website:build:with-map": "vp run architecture:map && vp run website:build"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.7.0",
    "elkjs": "^0.12.1",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.16"
  },
  "packageManager": "pnpm@10.33.0"
}