{
  "name": "reason-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "developer:setup-machine": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-machine.ps1",
    "typecheck": "vp run -r typecheck",
    "maintain:markdown": "vp exec node ./scripts/maintain-markdown.mjs --write-report",
    "website:dev": "vp run -F @reasontracker/website dev",
    "website:build": "vp run -F @reasontracker/website build"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.16"
  },
  "packageManager": "pnpm@10.33.0"
}