{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "00-command-center-open",
      "type": "shell",
      "command": "vp",
      "args": [
        "run",
        "-F",
        "@reasontracker/00-command-center",
        "00:CommandCenter:open"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Documents/technical/Software"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "full-typecheck",
      "type": "shell",
      "command": "vp",
      "args": [
        "run",
        "typecheck"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Documents/technical/Software"
      },
      "problemMatcher": []
    }
  ]
}